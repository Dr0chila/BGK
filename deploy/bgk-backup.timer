# sudo cp deploy/bgk-backup.service deploy/bgk-backup.timer /etc/systemd/system/
# sudo systemctl daemon-reload && sudo systemctl enable --now bgk-backup.timer
[Unit]
Description=Daily BGK bot database backup

[Timer]
OnCalendar=*-*-* 04:30
# Сервер был выключен в 04:30 — дамп сделается при включении
Persistent=true

[Install]
WantedBy=timers.target
